# Server configuration
PORT=8080
NODE_ENV=development

# Shopify
SHOPIFY_WEBHOOK_SECRET=replace-with-shopify-webhook-secret
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-admin-access-token

# Printoteca credentials
PRINTOTECA_APP_ID=your-printoteca-app-id
PRINTOTECA_SECRET_KEY=your-printoteca-secret-key
PRINTOTECA_BRAND_NAME=your-printoteca-brand-name
PRINTOTECA_BASE_URL=https://printoteca.ro/api
PRINTOTECA_DEFAULT_SHIPPING_METHOD=courier
PRINTOTECA_ENABLE_SANDBOX=true
PRINTO_TECA_WEBHOOK_SECRET=optional-secret

# Compatibility aliases (optional; prefer the names above)
# DEFAULT_SHIPPING_METHOD=courier
# PRINTOTECA_API_BASE=https://printoteca.ro/api
